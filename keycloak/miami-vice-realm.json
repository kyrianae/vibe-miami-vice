      "email": "tenant1-readonly@miami-vice.local",
      "firstName": "Tenant1",
      "lastName": "Readonly",
      "credentials": [
        {
          "type": "password",
          "value": "tenant1readonly123",
          "temporary": false
        }
      ],
      "realmRoles": ["tenant-readonly"],
      "groups": ["/tenant1"]
    },
    {
      "username": "tenant2-admin",
      "enabled": true,
      "emailVerified": true,
      "email": "tenant2-admin@miami-vice.local",
