{
  "realm": "miami-vice",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "accessTokenLifespan": 1800,
  "bruteForceProtected": true,
  "roles": {
    "realm": [
      {
        "name": "global-admin",
        "description": "RBAC multi-tenant (plan.md action 11) : accès complet, tous tenants, lecture/écriture/schéma sans restriction."
      },
      {
        "name": "tenant-admin",
        "description": "RBAC multi-tenant (plan.md action 11) : lecture/écriture restreinte au(x) tenant(s) de l'utilisateur (groupes Keycloak) + aux objets/classes non tenantés (globaux)."
      },
      {
        "name": "tenant-readonly",
        "description": "RBAC multi-tenant (plan.md action 11) : lecture seule restreinte au(x) tenant(s) de l'utilisateur + aux objets/classes non tenantés ; toute écriture est rejetée (403)."
      }
    ]
  },
  "groups": [
    {
      "name": "tenant1"
    },
    {
      "name": "tenant2"
    }
  ],
  "clients": [
    {
      "clientId": "miami-vice-service",
      "name": "Miami Vice - compte de service (automatisation)",
      "description": "Client confidentiel client_credentials, pour scripts/purge (action 6.2) et intégrations serveur à serveur. Pas d'utilisateur humain.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "miami-vice-service-secret-dev",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "authorizationServicesEnabled": false,
      "redirectUris": [],
      "webOrigins": [],
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "tenants-group-membership",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true",
            "claim.name": "tenants"
          }
        }
      ]
    },
    {
      "clientId": "miami-vice-direct",
      "name": "Miami Vice - login direct (frontend)",
      "description": "Client public, Direct Access Grants (Resource Owner Password Credentials) pour le formulaire de login du frontend tant qu'il n'y a pas de routeur pour un flux Authorization Code.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "tenants-group-membership",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true",
            "claim.name": "tenants"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "testuser",
      "enabled": true,
      "emailVerified": true,
      "email": "testuser@miami-vice.local",
      "firstName": "Test",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "testuser123",
          "temporary": false
        }
      ],
      "realmRoles": ["global-admin"]
    },
    {
      "username": "service-account-miami-vice-service",
      "enabled": true,
      "serviceAccountClientId": "miami-vice-service",
      "realmRoles": ["global-admin"]
    },
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "email": "admin@miami-vice.local",
      "firstName": "Global",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "realmRoles": ["global-admin"]
    },
    {
      "username": "tenant1-admin",
      "enabled": true,
