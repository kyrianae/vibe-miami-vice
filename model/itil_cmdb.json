{
    "$schema": "schema.json",
    "meta_class": "cmdb",
    "depends_on": [
        "personne"
    ],
    "classes": [
        {
            "class": "datacenter",
            "displayname": "{{nom}}",
            "attributes": [
                {
                    "domain": "details",
                    "name": "nom",
                    "type": "string"
                },
                {
                    "domain": "physique",
                    "name": "localisation",
                    "type": "string"
                }
            ]
        },
        {
            "class": "serveur",
            "displayname": "{{nom}}",
            "attributes": [
                {
                    "domain": "details",
                    "name": "nom",
                    "type": "string"
                },
                {
                    "domain": "adresse",
                    "name": "ip",
                    "type": "string",
                    "constraint": "^(\\d{1,3}\\.){3}\\d{1,3}$"
                },
                {
                    "domain": "logique",
                    "name": "environnement",
                    "type": "string"
                },
                {
                    "domain": "lien",
                    "name": "datacenter",
                    "type": "joint-1-1",
                    "classes": [
                        "datacenter"
                    ]
                }
            ]
        },
        {
            "class": "base_de_donnees",
            "displayname": "{{nom}}",
            "attributes": [
                {
                    "domain": "details",
                    "name": "nom",
                    "type": "string"
                },
                {
                    "domain": "logique",
                    "name": "moteur",
                    "type": "string"
                },
                {
                    "domain": "lien",
                    "name": "serveur",
                    "type": "joint-1-1",
                    "classes": [
                        "serveur"
                    ]
                }
            ]
        },
        {
            "class": "application",
            "displayname": "{{nom}}",
            "attributes": [
                {
                    "domain": "details",
                    "name": "nom",
                    "type": "string"
                },
                {
                    "domain": "logique",
                    "name": "version",
                    "type": "string"
                },
                {
                    "domain": "lien",
                    "name": "serveurs",
                    "type": "joint-1-n",
                    "classes": [
                        "serveur"
                    ]
                },
                {
                    "domain": "lien",
                    "name": "base_de_donnees",
                    "type": "joint-1-1",
                    "classes": [
                        "base_de_donnees"
                    ]
                }
            ]
        },
        {
            "class": "service_metier",
            "displayname": "{{nom}}",
            "attributes": [
                {
                    "domain": "details",
                    "name": "nom",
                    "type": "string"
                },
                {
                    "domain": "logique",
                    "name": "criticite",
                    "type": "string"
                },
                {
                    "domain": "lien",
                    "name": "applications",
                    "type": "joint-1-n",
                    "classes": [
                        "application"
                    ]
                },
                {
                    "domain": "lien",
                    "name": "responsable",
                    "type": "joint-1-1",
                    "classes": [
                        "personne_physique"
                    ]
                }
            ]
        },
        {
            "class": "fournisseur",
            "displayname": "{{nom}}",
            "attributes": [
                {
                    "domain": "details",
                    "name": "nom",
                    "type": "string"
                },
                {
                    "domain": "adresse",
                    "name": "contact",
                    "type": "string"
                }
            ]
        },
        {
            "class": "contrat_support",
            "displayname": "{{reference}}",
            "attributes": [
                {
                    "domain": "details",
                    "name": "reference",
                    "type": "string"
                },
                {
                    "domain": "lien",
                    "name": "fournisseur",
                    "type": "joint-1-1",
                    "classes": [
                        "fournisseur"
                    ]
                },
                {
                    "domain": "lien",
                    "name": "ci_couverts",
                    "type": "joint-1-n",
                    "classes": [
                        "serveur",
                        "application",
                        "service_metier"
                    ]
                }
            ]
        }
    ]
}
