{
    "$schema": "schema.json",
    "meta_class": "cmdb",
    "depends_on": [
        "organisation",
        "cluster",
        "localisation",
        "demo_kafka"
    ],
    "classes": [
        {
            "class": "datacenter",
            "displayname": "{{nom}}",
            "layers": ["physique"],
            "attributes": [
                {
                    "domain": "details",
                    "name": "nom",
                    "type": "string"
                },
                {
                    "domain": "physique",
                    "name": "localisation",
                    "type": "string",
                    "autosuggest": true
                }
            ]
        },
        {
            "class": "baie_serveur",
            "displayname": "{{nom}}",
            "layers": ["infra", "physique"],
            "attributes": [
                {
                    "domain": "details",
                    "name": "nom",
                    "type": "string"
                },
                {
                    "domain": "lien",
                    "name": "datacenter",
                    "type": "joint-1-1",
                    "classes": [
                        "datacenter"
                    ]
                },
                {
                    "domain": "physique",
                    "name": "position_rack",
                    "type": "string"
                }
            ]
        },
        {
            "class": "serveur",
            "displayname": "{{nom}}",
            "icon": "server",
            "layers": ["reseau"],
            "attributes": [
                {
                    "domain": "details",
                    "name": "nom",
                    "type": "string"
                },
                {
                    "domain": "logique",
                    "name": "type",
                    "type": "select",
                    "values": ["physique", "vm"],
                    "layer_map": {
                        "physique": ["physique"]
                    }
                },
                {
                    "domain": "adresse",
                    "name": "ip",
                    "type": "string",
                    "constraint": "^(\\d{1,3}\\.){3}\\d{1,3}$"
                },
                {
                    "domain": "logique",
                    "name": "environnement",
                    "type": "string"
                },
                {
                    "domain": "lien",
                    "name": "datacenter",
                    "type": "joint-1-1",
                    "classes": [
                        "datacenter"
                    ]
                },
                {
                    "domain": "display",
                    "name": "logo",
                    "type": "image"
                },
                {
                    "domain": "supervision",
                    "name": "monitoring",
                    "type": "datasource",
                    "classes": ["query"]
                },
                {
                    "domain": "logique",
                    "name": "actif",
                    "type": "boolean"
                },
                {
                    "domain": "lien",
                    "name": "hyperviseur",
                    "type": "joint-1-1",
                    "classes": [
                        "hyperviseur"
                    ]
                },
                {
                    "domain": "lien",
                    "name": "os",
                    "type": "joint-1-1",
                    "classes": [
                        "os"
                    ]
                }
            ]
        },
        {
            "class": "os",
            "displayname": "{{nom}}",
            "layers": ["infra"],
            "attributes": [
                {
                    "domain": "details",
                    "name": "nom",
                    "type": "string",
                    "autosuggest": true
                },
                {
                    "domain": "logique",
                    "name": "type",
                    "type": "select",
                    "values": ["linux", "windows"]
                },
                {
                    "domain": "logique",
                    "name": "architecture",
                    "type": "select",
                    "values": ["32", "64", "arm"]
                },
                {
                    "domain": "logique",
                    "name": "version",
                    "type": "string"
                },
                {
                    "domain": "logique",
                    "name": "code_version",
                    "type": "string"
                },
                {
                    "domain": "logique",
                    "name": "active",
                    "type": "boolean"
                }
            ]
        },
        {
            "class": "base_de_donnees",
            "displayname": "{{nom}}",
            "layers": ["securite"],
            "attributes": [
                {
                    "domain": "details",
                    "name": "nom",
                    "type": "string"
                },
                {
                    "domain": "logique",
                    "name": "moteur",
                    "type": "string"
                },
                {
                    "domain": "lien",
                    "name": "serveur",
                    "type": "joint-1-1",
                    "classes": [
                        "serveur"
                    ]
                }
            ]
        },
        {
            "class": "application",
            "displayname": "{{nom}}",
            "attributes": [
                {
                    "domain": "details",
                    "name": "nom",
                    "type": "string"
                },
                {
                    "domain": "logique",
                    "name": "version",
                    "type": "string"
                },
                {
                    "domain": "lien",
                    "name": "serveurs",
                    "type": "joint-1-n",
                    "classes": [
                        "serveur"
                    ]
                },
                {
                    "domain": "lien",
                    "name": "base_de_donnees",
                    "type": "joint-1-1",
                    "classes": [
                        "base_de_donnees"
                    ]
                },
                {
                    "domain": "lien",
                    "name": "modules",
                    "type": "joint-1-n",
                    "classes": [
                        "module"
                    ]
                },
                {
                    "domain": "demo",
                    "name": "demo_role",
                    "type": "select",
                    "values": ["frontend", "backend", "service"]
                },
                {
                    "domain": "demo",
                    "name": "demo_vm",
                    "type": "joint-1-1",
                    "classes": [
                        "vm"
                    ]
                },
                {
                    "domain": "demo",
                    "name": "demo_base_donnees",
                    "type": "joint-1-1",
                    "classes": [
                        "base_donnees"
                    ]
                },
                {
                    "domain": "demo",
                    "name": "demo_bus",
                    "type": "joint-1-1",
                    "classes": [
                        "bus_kafka"
                    ]
                },
                {
                    "domain": "demo",
                    "name": "demo_produit",
                    "type": "joint-1-n",
                    "classes": [
                        "type_donnee"
                    ]
                },
                {
                    "domain": "demo",
                    "name": "demo_consomme",
                    "type": "joint-1-n",
                    "classes": [
                        "type_donnee"
                    ]
                }
            ]
        },
        {
            "class": "module",
            "displayname": "{{nom}}",
            "layers": ["applicatif"],
            "attributes": [
                {
                    "domain": "details",
                    "name": "nom",
                    "type": "string"
                },
                {
                    "domain": "lien",
                    "name": "application",
                    "type": "joint-1-1",
                    "classes": [
                        "application"
                    ]
                }
            ]
        },
        {
            "class": "container",
            "displayname": "{{nom}}",
            "layers": ["applicatif", "infra"],
            "attributes": [
                {
                    "domain": "details",
                    "name": "nom",
                    "type": "string"
                },
                {
                    "domain": "logique",
                    "name": "image",
                    "type": "string"
                },
                {
                    "domain": "lien",
                    "name": "namespace_kubernetes",
                    "type": "joint-1-1",
                    "classes": [
                        "namespace_kubernetes"
                    ]
                }
            ]
        },
        {
            "class": "namespace_kubernetes",
            "displayname": "{{nom}}",
            "layers": ["applicatif", "infra"],
            "attributes": [
                {
                    "domain": "details",
                    "name": "nom",
                    "type": "string"
                },
                {
                    "domain": "lien",
                    "name": "kube",
                    "type": "joint-1-1",
                    "classes": [
                        "kube"
                    ]
                }
            ]
        },
        {
            "class": "interface",
            "displayname": "{{nom}}",
            "layers": ["applicatif", "fonctionnel"],
            "attributes": [
                {
                    "domain": "details",
                    "name": "nom",
                    "type": "string"
                },
                {
                    "domain": "logique",
                    "name": "type",
                    "type": "select",
                    "values": ["REST", "SOAP", "file", "queue", "db"]
                },
                {
                    "domain": "lien",
                    "name": "application",
                    "type": "joint-1-1",
                    "classes": [
                        "application"
                    ]
                }
            ]
        },
        {
            "class": "flux_donnee",
            "displayname": "{{nom}}",
            "layers": ["fonctionnel", "metier"],
            "attributes": [
                {
                    "domain": "details",
                    "name": "nom",
                    "type": "string"
                },
                {
                    "domain": "logique",
                    "name": "type_donnee",
                    "type": "string"
                },
                {
                    "domain": "lien",
                    "name": "interface_source",
                    "type": "joint-1-1",
                    "classes": [
                        "interface"
                    ]
                },
                {
                    "domain": "lien",
                    "name": "interface_cible",
                    "type": "joint-1-1",
                    "classes": [
                        "interface"
                    ]
                }
            ]
        },
        {
            "class": "application_versionnee",
            "displayname": "{{version}}",
            "layers": ["applicatif"],
            "attributes": [
                {
                    "domain": "lien",
                    "name": "application",
                    "type": "joint-1-1",
                    "classes": [
                        "application"
                    ]
                },
                {
                    "domain": "logique",
                    "name": "version",
                    "type": "string",
                    "autosuggest": true
                },
                {
                    "domain": "lien",
                    "name": "modules_versionnes",
                    "type": "joint-1-n",
                    "classes": [
                        "module_versionne"
                    ]
                }
            ]
        },
        {
            "class": "module_versionne",
            "displayname": "{{version}}",
            "layers": ["applicatif"],
            "attributes": [
                {
                    "domain": "lien",
                    "name": "module",
                    "type": "joint-1-1",
                    "classes": [
                        "module"
                    ]
                },
                {
                    "domain": "logique",
                    "name": "version",
                    "type": "string",
                    "autosuggest": true
                }
            ]
        },
        {
            "class": "materiel",
            "displayname": "{{nom}}",
            "layers": ["infra", "physique"],
            "attributes": [
                {
                    "domain": "details",
                    "name": "nom",
                    "type": "string"
                },
                {
                    "domain": "logique",
                    "name": "type",
                    "type": "select",
                    "values": ["poste", "imprimante", "peripherique"]
                },
                {
                    "domain": "details",
                    "name": "numero_serie",
                    "type": "string"
                },
                {
                    "domain": "lien",
                    "name": "personne_affectee",
                    "type": "joint-1-1",
                    "classes": [
                        "personne_physique"
                    ]
                },
                {
                    "domain": "lien",
                    "name": "salle",
                    "type": "joint-1-1",
                    "classes": [
                        "salle"
                    ]
                }
            ]
        },
        {
            "class": "service_metier",
            "displayname": "{{nom}}",
            "attributes": [
                {
                    "domain": "details",
                    "name": "nom",
                    "type": "string"
                },
                {
                    "domain": "logique",
                    "name": "criticite",
                    "type": "string"
                },
                {
                    "domain": "lien",
                    "name": "applications",
                    "type": "joint-1-n",
                    "classes": [
                        "application"
                    ]
                },
                {
                    "domain": "lien",
                    "name": "responsable",
                    "type": "joint-1-1",
                    "classes": [
                        "personne_physique"
                    ]
                }
            ]
        },
        {
            "class": "fournisseur",
            "displayname": "{{nom}}",
            "attributes": [
                {
                    "domain": "details",
                    "name": "nom",
                    "type": "string"
                },
                {
                    "domain": "adresse",
                    "name": "contact",
                    "type": "string"
                }
            ]
        },
        {
            "class": "contrat_support",
            "displayname": "{{reference}}",
            "attributes": [
                {
                    "domain": "details",
                    "name": "reference",
                    "type": "string"
                },
                {
                    "domain": "lien",
                    "name": "fournisseur",
                    "type": "joint-1-1",
                    "classes": [
                        "fournisseur"
                    ]
                },
                {
                    "domain": "lien",
                    "name": "ci_couverts",
                    "type": "joint-1-n",
                    "classes": [
                        "serveur",
                        "application",
                        "service_metier"
                    ]
                }
            ]
        }
    ]
}
