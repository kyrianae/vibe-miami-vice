{
    "$schema": "schema.json",
    "meta_class": "element_avec_ip",
    "classes": [
        {
            "class": "addresse_ip",
            "displayname": "{{adresse_ip}}",
            "attributes": [
                {
                    "domain": "network",
                    "name": "adresse_ip",
                    "type": "string",
                    "constraint": "^(\\d{1,3}\\.){3}\\d{1,3}$",
                    "sql_constraint": "UNIQUE VALUE"
                },
                {
                    "domain": "lien",
                    "name": "vlan",
                    "type": "joint-1-1",
                    "classes": [
                        "vlan"
                    ]
                }
            ]
        },
        {
            "class": "vlan",
            "displayname": "{{nom}}",
            "attributes": [
                {
                    "domain": "details",
                    "name": "nom",
                    "type": "string"
                },
                {
                    "domain": "network",
                    "name": "definition",
                    "type": "string",
                    "constraint": "(\\d{1,3}\\.){3}\\d{1,3}\\/\\d{1,2}$"
                },
                {
                    "domain": "network",
                    "name": "membres",
                    "type": "joint-1-n",
                    "classes": [
                        "addresse_ip"
                    ]
                }
            ]
        },
        {
            "class": "zone_reseau",
            "displayname": "{{nom}}",
            "layers": ["infra", "reseau", "securite"],
            "attributes": [
                {
                    "domain": "details",
                    "name": "nom",
                    "type": "string"
                },
                {
                    "domain": "securite",
                    "name": "niveau_securite",
                    "type": "string"
                }
            ]
        },
        {
            "class": "equipement_reseau",
            "displayname": "{{nom}}",
            "layers": ["infra", "reseau"],
            "attributes": [
                {
                    "domain": "details",
                    "name": "nom",
                    "type": "string"
                },
                {
                    "domain": "logique",
                    "name": "type",
                    "type": "select",
                    "values": ["routeur", "switch", "firewall"]
                },
                {
                    "domain": "lien",
                    "name": "zone",
                    "type": "joint-1-1",
                    "classes": [
                        "zone_reseau"
                    ]
                }
            ]
        },
        {
            "class": "entree_dns",
            "displayname": "{{nom}}",
            "layers": ["infra", "reseau"],
            "attributes": [
                {
                    "domain": "details",
                    "name": "nom",
                    "type": "string"
                },
                {
                    "domain": "logique",
                    "name": "type",
                    "type": "select",
                    "values": ["A", "CNAME", "MX", "TXT", "NS"]
                },
                {
                    "domain": "network",
                    "name": "cible",
                    "type": "string"
                },
                {
                    "domain": "network",
                    "name": "zone_dns",
                    "type": "string"
                }
            ]
        }
    ]
}
