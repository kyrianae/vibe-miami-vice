{
    "$schema": "schema.json",
    "meta_class": "datasource",
    "classes": [
        {
            "class": "datasource_prometheus",
            "displayname": "{{url}}",
            "attributes": [
                {
                    "domain": "connexion",
                    "name": "url",
                    "type": "string"
                }
            ]
        },
        {
            "class": "query",
            "displayname": "{{name}}",
            "attributes": [
                {
                    "domain": "details",
                    "name": "name",
                    "type": "string"
                },
                {
                    "domain": "requete",
                    "name": "expression",
                    "type": "string"
                },
                {
                    "domain": "lien",
                    "name": "datasource",
                    "type": "joint-1-1",
                    "classes": [
                        "datasource_prometheus"
                    ]
                }
            ]
        }
    ]
}
