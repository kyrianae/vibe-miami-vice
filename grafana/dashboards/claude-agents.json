{
  "uid": "claude-agents",
  "title": "Claude Agents Activity",
  "timezone": "browser",
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "Agent activity (0=idle, 1=active) — par type, timeline multi-état",
      "type": "state-timeline",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "claude_agent",
          "legendFormat": "{{agent}}",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "idle", "color": "dark-red", "index": 0 },
                "1": { "text": "active", "color": "green", "index": 1 }
              }
            }
          ],
          "color": { "mode": "thresholds" },
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 90
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "alignValue": "left",
        "rowHeight": 0.9,
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      }
    },
    {
      "id": 2,
      "title": "État instantané par agent",
      "type": "state-timeline",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "claude_agent",
          "legendFormat": "{{agent}}",
          "refId": "A",
          "instant": true,
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "idle", "color": "dark-red", "index": 0 },
                "1": { "text": "active", "color": "green", "index": 1 }
              }
            }
          ],
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": false,
        "showValue": "always",
        "rowHeight": 0.9,
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    }
  ]
}
